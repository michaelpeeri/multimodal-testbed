{
  "problem_fn":   "/content/Drive/MyDrive/colab/test_problem_3.pt",
  "storage":      "sqlite:///tuning.db",
  "output":       "tuned_configs.2.attempt2.json",
  "batch_size":   256,
  "n_trials":      50,
  "max_epochs":    50,
  "eval_every":     1,
  "mask_fraction":  0.4,
  "sampler":    "tpe",
  "pruner":     "median",
  "models": [
    "GeneExpressionVAE",
    "DEQEncoderVAE",
    "VampPriorVAE",
    "DEQEncoderVampVAE"
  ],
  "search_space": {
    "lr":                    { "type": "float", "low": 1e-4,  "high": 1e-3, "log": true },
    "beta":                  { "type": "float", "low": 1e-4,  "high": 0.2,  "log": true },
    "gamma":                 { "type": "float", "low": 0.5,   "high": 6.0               },
    "min_free_bits":         { "type": "float", "low": 0.001, "high": 0.05, "log": true },
    "lambda_entropy":        { "type": "float", "low": 1e-3,  "high": 0.3,  "log": true },
    "lambda_vamp_repulsion": { "type": "float", "low": 1e-3,  "high": 0.5,  "log": true },
    "lambda_vamp_coverage":  { "type": "float", "low": 1e-3,  "high": 0.5,  "log": true }
  }
}
